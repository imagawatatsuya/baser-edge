{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baser-edge-api",
  "main": "apps/api-worker/dist/index.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baser-edge-trial",
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ],



  "assets": {
    "directory": "./apps/admin-web/dist",
    "binding": "STATIC_ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "vars": {
    "BASER_ASSET_STORAGE": "d1-inline",
    "BASER_ENV": "preview",
    "PUBLIC_BASE_URL": "https://api.example.invalid",
    "PREVIEW_BASE_URL": "https://preview.example.invalid",
    "PLUGIN_OUTBOUND_POLICY_ENFORCED": "false",
    "BASER_INSTANT_LOGIN": "false",
    "BASER_INSTANT_OWNER_HINT": ""
  }
}
