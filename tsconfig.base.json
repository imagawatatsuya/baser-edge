{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@baser-edge/core-types": [
        "packages/core-types/src/index.ts"
      ],
      "@baser-edge/structured-document": [
        "packages/structured-document/src/index.ts"
      ],
      "@baser-edge/baser-domain": [
        "packages/baser-domain/src/index.ts"
      ],
      "@baser-edge/authorization": [
        "packages/authorization/src/index.ts"
      ],
      "@baser-edge/auth-kernel": [
        "packages/auth-kernel/src/index.ts"
      ],
      "@baser-edge/content-kernel": [
        "packages/content-kernel/src/index.ts"
      ],
      "@baser-edge/agent-tools": [
        "packages/agent-tools/src/index.ts"
      ],
      "@baser-edge/renderer": [
        "packages/renderer/src/index.ts"
      ],
      "@baser-edge/cloudflare-adapters": [
        "packages/cloudflare-adapters/src/index.ts"
      ],
      "@baser-edge/theme-kernel": [
        "packages/theme-kernel/src/index.ts"
      ],
      "@baser-edge/plugin-kernel": [
        "packages/plugin-kernel/src/index.ts"
      ]
    }
  }
}
