# --- Dependencies (largest working-tree footprint; never commit) ---
node_modules/
**/node_modules/

# --- Public release staging (no private git history; safe to push elsewhere) ---
release/public-snapshot/
release/public-snapshot-test/

# --- Build outputs ---
dist/
**/dist/
*.tsbuildinfo
build/
.vite/
.turbo/
.cache/
_site/

# --- Cloudflare / Wrangler ---
.wrangler/
.mf/
.dev.vars
.dev.vars.*
!.dev.vars.example

# --- Local dev stack (auto ports from serve-stack) ---
.baser/
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# --- Deploy state (keep tracked examples) ---
deploy/cloudflare-state.json
deploy/cloudflare-state.*.json
!deploy/cloudflare-state.example.json
deploy/cloudflare-secrets.json
deploy/onboarding-sessions/
deploy/_preview/

# --- Test / coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# --- Logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editor (keep .cursor/rules/ in repo; ignore local IDE state) ---
.cursor/settings.json
.cursor-task-mit-review/
.idea/
*.swp
*.swo
*~
