{
  "name": "baser-edge",
  "version": "0.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b",
    "test": "npm run build && npm run build:admin-web && node --test tests/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:wrangler": "node scripts/verify-wrangler-tracked.mjs",
    "verify:admin-router": "node scripts/verify-admin-router.mjs",
    "verify:cms-knowledge": "node scripts/agents/verify-cms-knowledge-registry.mjs",
    "context:skills:init": "node scripts/agents/update-context-snapshot.mjs --write",
    "context:skills:check": "node scripts/agents/check-context-drift.mjs --strict=blocking",
    "check:agent-skills": "node scripts/validate-agent-skills.mjs && npm run verify:cms-knowledge && npm run context:skills:check",
    "check": "npm run test && npm run verify:schema && npm run verify:wrangler && npm run verify:admin-router && npm run check:agent-skills && npm run check:onboarding-worker && npm run check:cloud-operations-worker",
    "smoke:stack": "node scripts/smoke-local-flow.mjs",
    "prove:local": "npm run build && npm run build:admin-web && node scripts/prove-local.mjs",
    "dev:api": "npm run build && node scripts/serve-api.mjs",
    "dev:admin": "node scripts/serve-admin.mjs",
    "dev:stack": "npm run build && npm run build:admin-web && node scripts/serve-stack.mjs",
    "build:admin-web": "npm run build -w @baser-edge/admin-web",
    "dev:console": "npm run dev -w @baser-edge/admin-web",
    "diagnose:theme": "node tools/basercms-theme-diagnostics/cli.mjs",
    "diagnose:plugin": "node tools/basercms-plugin-diagnostics/cli.mjs",
    "provision:cloudflare": "node scripts/cloudflare/provision.mjs",
    "deploy:cloudflare": "node scripts/cloudflare/deploy.mjs",
    "push:cms-oauth-secrets": "node scripts/cloudflare/push-cms-oauth-secrets.mjs",
    "bind:cloudflare-owner": "node scripts/cloudflare/bind-cloudflare-owner.mjs",
    "browser:cms-login": "node scripts/cloudflare/open-cms-login-browser.mjs",
    "preflight:cloudflare": "node scripts/cloudflare/preflight.mjs",
    "plan:cloudflare": "node scripts/cloudflare/plan.mjs",
    "preview:start-page": "node scripts/preview-start-page.mjs",
    "prove:cloudflare": "node scripts/cloudflare/prove.mjs",
    "enable-media:cloudflare": "node scripts/cloudflare/enable-media.mjs",
    "destroy:cloudflare": "node scripts/cloudflare/destroy.mjs",
    "revert:wrangler": "node scripts/cloudflare/revert-wrangler-after-cloud.mjs",
    "refresh:oauth-trial": "node scripts/cloudflare/refresh-oauth-trial-bootstrap.mjs",
    "smoke:cloudflare": "node scripts/cloudflare/smoke-remote.mjs",
    "dev:onboarding": "node scripts/onboarding/dev.mjs",
    "dev:onboarding-api": "node scripts/onboarding/server.mjs",
    "build:onboarding-web": "npm run build -w @baser-edge/onboarding-web",
    "start:onboarding": "npm run build:onboarding-web && node scripts/onboarding/server.mjs",
    "pack:trial-release": "node scripts/cloudflare/pack-trial-release.mjs",
    "bundle:onboarding-worker": "node scripts/cloudflare/bundle-onboarding-worker.mjs",
    "ensure:trial-provision-queue": "node scripts/cloudflare/ensure-trial-provision-queue.mjs",
    "deploy:trial-host": "npm run ensure:trial-provision-queue && npm run pack:trial-release && npm run build:onboarding-web && wrangler deploy -c wrangler.onboarding-host.jsonc",
    "deploy:trial-host:prebundled": "npm run ensure:trial-provision-queue && npm run pack:trial-release && npm run build:onboarding-web && npm run bundle:onboarding-worker && wrangler deploy -c wrangler.onboarding-host.prebundled.jsonc",
    "check:onboarding-worker": "npm run check -w @baser-edge/onboarding-worker",
    "check:cloud-operations-worker": "npm run check -w @baser-edge/cloud-operations-worker",
    "setup:ops-broker-secret": "node scripts/cloudflare/push-ops-broker-secret.mjs",
    "deploy:cloud-operations": "wrangler deploy -c wrangler.cloud-operations.jsonc",
    "prepare:public-snapshot": "node scripts/release/prepare-public-snapshot.mjs",
    "prepare:public-snapshot:git": "node scripts/release/prepare-public-snapshot.mjs --init-git"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.62.2",
    "@rollup/rollup-darwin-x64": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-win32-x64-gnu": "4.62.2"
  }
}
